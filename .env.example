APP_NAME=Clinicify
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:5000

JWT_SECRET=

STRIPE_SECRET=
STRIPE_CURRENCY=egp

OPENVIDU_URL=http://openvidu:4443
OPENVIDU_SECRET=MY_SECRET
OPENVIDU_PUBLIC_URL=http://localhost:4443

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
# Use `db` when the API runs in Docker Compose. Use `127.0.0.1` for host PHP + Docker MySQL.
DB_HOST=db
DB_PORT=3306
DB_DATABASE=clinicify
DB_USERNAME=clinicify
DB_PASSWORD=clinicify

CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=log
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
